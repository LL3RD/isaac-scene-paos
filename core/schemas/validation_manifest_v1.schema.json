{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "isaac-scene-validation-manifest/v1",
  "title": "Isaac Scene Validation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "quality_policy",
    "scene_spec",
    "compile_report",
    "validate_scene_reports",
    "overlap_reports",
    "support_reports",
    "facing_reports",
    "render_feedback_reports"
  ],
  "properties": {
    "schema_version": {"const": "isaac-scene-validation-manifest/v1"},
    "quality_policy": {"enum": ["layout_only", "realistic", "reference_match"]},
    "scene_spec": {"type": "string", "minLength": 1},
    "compile_report": {"type": "string", "minLength": 1},
    "validate_scene_reports": {"$ref": "#/$defs/pathList"},
    "overlap_reports": {"$ref": "#/$defs/pathList"},
    "support_reports": {"$ref": "#/$defs/pathList"},
    "facing_reports": {"$ref": "#/$defs/pathList"},
    "render_feedback_reports": {"$ref": "#/$defs/pathList"},
    "output": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "pathList": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
