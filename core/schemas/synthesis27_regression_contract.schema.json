{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/schemas/synthesis27_regression_contract.schema.json",
  "title": "Synthesis-27 text/image regression contract",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "source_snapshot_sha256",
    "source_policy",
    "case_count",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "synthesis27-regression-contract/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_policy": {
      "type": "string",
      "minLength": 1
    },
    "case_count": {
      "type": "integer",
      "minimum": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "domain",
          "generation_inputs",
          "generator_visibility",
          "expected_outputs",
          "acceptance",
          "oracle",
          "baseline"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "slug": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "generation_inputs": {
            "type": "object",
            "required": ["text_only", "reference_guided"]
          },
          "oracle": {
            "type": "object",
            "required": [
              "hidden_from_generator",
              "target_generated_instance_count",
              "semantic_instance_targets",
              "exact_asset_targets",
              "anchor_targets",
              "license_excluded_targets"
            ],
            "properties": {
              "hidden_from_generator": {"const": true}
            }
          }
        }
      }
    }
  }
}
