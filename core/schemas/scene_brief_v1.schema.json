{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "isaac-scene-brief/v1",
  "type": "object",
  "required": ["schema_version", "inputs", "domain", "quality_policy", "room", "objects"],
  "properties": {
    "schema_version": {"const": "isaac-scene-brief/v1"},
    "inputs": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["text", "image", "hybrid"]},
        "text": {"type": "string"},
        "reference_images": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"type": "string"},
              "width_px": {"type": "integer", "minimum": 1},
              "height_px": {"type": "integer", "minimum": 1},
              "content_bbox_px": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
              "content_bbox_norm": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
              "content_width_px": {"type": "integer", "minimum": 1},
              "content_height_px": {"type": "integer", "minimum": 1},
              "content_aspect_ratio": {"type": "number", "exclusiveMinimum": 0},
              "border_detected": {"type": "boolean"},
              "view_id": {"type": "string"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "domain": {"type": "string"},
    "quality_policy": {"enum": ["layout_only", "realistic", "reference_match"]},
    "room": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "size_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "size_confidence": {"enum": ["high", "medium", "low"]},
        "center_m": {"$ref": "#/$defs/vec3"},
        "style_tags": {"type": "array", "items": {"type": "string"}},
        "shell_preset": {"type": "string"},
        "shell_preset_options": {
          "type": "object",
          "properties": {
            "preserve_open_sides": {"type": "boolean"},
            "preserve_architectural_elements": {"type": "boolean"},
            "replace_lighting": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "floor": {"$ref": "#/$defs/surface"},
        "walls": {"$ref": "#/$defs/surface"},
        "ceiling": {"$ref": "#/$defs/surface"},
        "open_sides": {
          "type": "array",
          "items": {"enum": ["front", "back", "left", "right", "ceiling"]}
        },
        "openings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "wall"],
            "properties": {
              "id": {"type": "string"},
              "type": {"enum": ["door", "window", "archway"]},
              "wall": {"enum": ["front", "back", "left", "right"]},
              "center_m": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
              "size_m": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}}
            },
            "additionalProperties": true
          }
        },
        "architectural_elements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "size", "translate"],
            "properties": {
              "id": {"type": "string"},
              "type": {"enum": ["box", "glass_panel", "frame", "beam"]},
              "translate": {"$ref": "#/$defs/vec3"},
              "rotate": {"$ref": "#/$defs/vec3"},
              "size": {"$ref": "#/$defs/vec3positive"},
              "display_color": {"$ref": "#/$defs/color"},
              "display_opacity": {"type": "number", "minimum": 0, "maximum": 1},
              "material_roughness": {"type": "number", "minimum": 0, "maximum": 1},
              "material_metallic": {"type": "number", "minimum": 0, "maximum": 1},
              "material_opacity": {"type": "number", "minimum": 0, "maximum": 1},
              "emissive_color": {"$ref": "#/$defs/color"},
              "physics": {"enum": ["none", "static", "dynamic", "articulated_fixed_base"]},
              "semantic_role": {
                "enum": [
                  "wall_panel",
                  "partition",
                  "mullion",
                  "structural_column",
                  "soffit",
                  "ceiling_rail",
                  "baseboard",
                  "shell_other"
                ]
              },
              "evidence": {"type": "string"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "camera": {
      "type": "object",
      "properties": {
        "projection": {"enum": ["perspective", "orthographic"]},
        "position_m": {"$ref": "#/$defs/vec3"},
        "look_at_m": {"$ref": "#/$defs/vec3"},
        "up_axis": {"enum": ["+Z"]},
        "focal_length_mm": {"type": "number", "exclusiveMinimum": 0},
        "exposure_ev": {"type": "number", "minimum": -10, "maximum": 10},
        "horizontal_fov_deg": {"type": "number", "exclusiveMinimum": 1, "maximum": 179},
        "target_aspect_ratio": {"type": "number", "exclusiveMinimum": 0},
        "render_resolution_px": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence": {"type": "string"}
      },
      "additionalProperties": true
    },
    "lighting": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["default", "reference_guided", "text_guided"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence": {"type": "string"},
        "environment": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "prim": {"type": "string"},
            "intensity": {"type": "number", "minimum": 0},
            "color": {"$ref": "#/$defs/color"},
            "texture": {"type": "string"}
          },
          "additionalProperties": true
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "type": {"enum": ["rect", "sphere", "distant", "disk"]},
              "prim": {"type": "string"},
              "translate": {"$ref": "#/$defs/vec3"},
              "rotate": {"$ref": "#/$defs/vec3"},
              "look_at": {"$ref": "#/$defs/vec3"},
              "width": {"type": "number", "exclusiveMinimum": 0},
              "height": {"type": "number", "exclusiveMinimum": 0},
              "radius": {"type": "number", "exclusiveMinimum": 0},
              "angle": {"type": "number", "minimum": 0},
              "intensity": {"type": "number", "minimum": 0},
              "color": {"$ref": "#/$defs/color"},
              "temperature": {"type": "number", "exclusiveMinimum": 0},
              "exposure": {"type": "number"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "semantic_class"],
        "properties": {
          "id": {"type": "string"},
          "atomic": {"type": "boolean"},
          "role": {"type": "string"},
          "semantic_class": {"type": "string"},
          "semantic_name": {"type": "string"},
          "count": {"type": "integer", "minimum": 1},
          "criticality": {"enum": ["anchor", "medium", "detail"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence": {"type": "string"},
          "size_m": {"$ref": "#/$defs/vec3positive"},
          "visual": {
            "type": "object",
            "properties": {
              "style_tags": {"type": "array", "items": {"type": "string"}},
              "material_tags": {"type": "array", "items": {"type": "string"}},
              "color_tags": {"type": "array", "items": {"type": "string"}},
              "shape_tags": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          },
          "screen_bbox_norm": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "depth_order": {"type": "number"},
          "zone": {"type": "string"},
          "support_target": {"type": "string"},
          "placement_policy": {"enum": ["solid", "floor_underlay", "non_blocking"]},
          "facing_target": {"type": "string"},
          "facing_mode": {
            "enum": ["auto", "target_center", "nearest_target_footprint"]
          },
          "wall_affinity": {"enum": ["none", "front", "back", "left", "right", "nearest"]},
          "minimum_clearance_m": {"type": "number", "minimum": 0},
          "identical_instances": {"type": "boolean"},
          "asset_binding": {
            "type": "object",
            "properties": {
              "logical_id": {"type": "string"},
              "model_id": {"type": "string"},
              "canonical_class": {"type": "string"},
              "asset_source": {"type": "string"},
              "license_status": {"type": "string"},
              "license_evidence": {"type": ["string", "object"]},
              "path": {"type": "string"},
              "query": {"type": "string"},
              "front_axis": {"enum": ["+X", "-X", "+Y", "-Y"]},
              "orientation_mode": {
                "enum": [
                  "front_facing",
                  "axial",
                  "bidirectional",
                  "radial",
                  "symmetric",
                  "scene_root",
                  "unknown"
                ]
              },
              "primary_axis": {"enum": ["X", "Y"]},
              "operator_axis": {"enum": ["+X", "-X", "+Y", "-Y"]},
              "flow_axis": {"enum": ["+X", "-X", "+Y", "-Y", "X", "Y", "unknown"]},
              "orientation_confidence": {"enum": ["high", "medium", "low"]},
              "orientation_source": {"type": "string"},
              "reference_match_evidence": {
                "type": "object",
                "properties": {
                  "status": {"enum": ["pass", "fail", "pending"]},
                  "preview_index_path": {"type": "string"},
                  "visual_score": {"type": "number"},
                  "candidate_pool_count": {"type": "integer", "minimum": 0},
                  "top_two_margin": {"type": "number"},
                  "method": {"type": "string"},
                  "selection_basis": {
                    "enum": [
                      "automatic_gate",
                      "independent_review_override",
                      "legacy"
                    ]
                  },
                  "manual_review": {
                    "type": "object",
                    "properties": {
                      "reviewers": {
                        "type": "array",
                        "minItems": 2,
                        "items": {"type": "string"}
                      },
                      "selected_preview_path": {"type": "string"},
                      "comparison_preview_paths": {
                        "type": "array",
                        "minItems": 2,
                        "items": {"type": "string"}
                      },
                      "reference_features": {
                        "type": "array",
                        "minItems": 2,
                        "items": {"type": "string"}
                      },
                      "rejected_candidates": {
                        "type": "array",
                        "minItems": 1,
                        "items": {"type": "object"}
                      },
                      "automatic_gate_failures": {
                        "type": "array",
                        "minItems": 1,
                        "items": {"type": "string"}
                      },
                      "identity_gate": {"enum": ["pass", "fail"]},
                      "geometry_gate": {"enum": ["pass", "fail"]},
                      "orientation_gate": {"enum": ["pass", "fail"]},
                      "rationale": {"type": "string"}
                    },
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              },
              "scale": {"$ref": "#/$defs/vec3positive"}
            },
            "additionalProperties": true
          },
          "instances": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": "string"},
                "translate_m": {"$ref": "#/$defs/vec3"},
                "rotate_deg": {"$ref": "#/$defs/vec3"},
                "screen_bbox_norm": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {"type": "number", "minimum": 0, "maximum": 1}
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "bounds_norm": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "purpose": {"type": "string"}
          ,"distribution": {"enum": ["center", "grid", "perimeter"]}
        },
        "additionalProperties": true
      }
    },
    "default_zone": {"type": "string"},
    "layout_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "zone"],
        "properties": {
          "id": {"type": "string"},
          "zone": {"type": "string"},
          "distribution": {"enum": ["center", "grid", "perimeter"]},
          "preferred_yaw_deg": {"type": "number"},
          "yaw_sequence_deg": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "yaw_deltas_deg": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "obstacle_clearance_m": {"type": "number", "minimum": 0},
          "support_margin_m": {"type": "number", "minimum": 0},
          "mount_surface": {"enum": ["ceiling"]},
          "match": {
            "type": "object",
            "properties": {
              "entity_ids": {"type": "array", "items": {"type": "string"}},
              "layout_roles": {"type": "array", "items": {"enum": ["mounted_fixture", "support_furniture", "ground_object", "supported_prop"]}},
              "semantic_terms": {"type": "array", "items": {"type": "string"}},
              "exclude_terms": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "functional_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "anchor_match", "members"],
        "properties": {
          "id": {"type": "string"},
          "anchor_match": {"$ref": "#/$defs/semantic_match"},
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["match", "per_anchor", "offsets_m"],
              "properties": {
                "match": {"$ref": "#/$defs/semantic_match"},
                "per_anchor": {"type": "integer", "minimum": 1},
                "offsets_m": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "number"}
                  }
                },
                "yaw_offsets_deg": {"type": "array", "minItems": 1, "items": {"type": "number"}},
                "yaw_deltas_deg": {"type": "array", "minItems": 1, "items": {"type": "number"}},
                "offset_reference": {"enum": ["placement_reference", "asset_origin"]},
                "facing_policy": {"enum": ["toward_anchor", "authored_yaw"]},
                "obstacle_clearance_m": {"type": "number", "minimum": 0}
                ,"position_tolerance_m": {"type": "number", "minimum": 0}
                ,"connection": {
                  "type": "object",
                  "required": ["anchor_port_local_m", "member_port_local_m"],
                  "properties": {
                    "anchor_port_local_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
                    "member_port_local_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
                    "position_tolerance_m": {"type": "number", "minimum": 0},
                    "require_semantic_evidence": {"type": "boolean"},
                    "require_opposed_normals": {"type": "boolean"},
                    "normal_tolerance_deg": {"type": "number", "minimum": 0, "maximum": 180},
                    "anchor_port": {"$ref": "#/$defs/functional_port"},
                    "member_port": {"$ref": "#/$defs/functional_port"}
                  },
                  "additionalProperties": true
                }
                ,"work_envelope": {
                  "type": "object",
                  "required": ["radius_m"],
                  "properties": {
                    "radius_m": {"type": "number", "exclusiveMinimum": 0},
                    "target_offset_local_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "circulation": {
      "type": "object",
      "properties": {
        "minimum_path_width_m": {"type": "number", "minimum": 0},
        "keep_clear_zones": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {"type": "string"},
                  "bounds_m": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {"type": "number"}
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "functional_port": {
      "type": "object",
      "required": ["id", "role", "normal_axis", "evidence_status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"enum": ["input", "output", "bidirectional", "service", "operator"]},
        "normal_axis": {"enum": ["+X", "-X", "+Y", "-Y"]},
        "evidence_status": {"enum": ["verified", "pending", "rejected"]},
        "evidence_source": {"type": "string"}
      },
      "additionalProperties": true
    },
    "semantic_match": {
      "type": "object",
      "properties": {
        "entity_ids": {"type": "array", "items": {"type": "string"}},
        "layout_roles": {"type": "array", "items": {"enum": ["mounted_fixture", "support_furniture", "ground_object", "supported_prop"]}},
        "semantic_terms": {"type": "array", "items": {"type": "string"}},
        "exclude_terms": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "vec3positive": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "color": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "surface": {
      "type": "object",
      "properties": {
        "material_tags": {"type": "array", "items": {"type": "string"}},
        "color_rgb": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "roughness": {"type": "number", "minimum": 0, "maximum": 1},
        "metallic": {"type": "number", "minimum": 0, "maximum": 1},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "emissive_color": {"$ref": "#/$defs/color"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
